ed":false},{"uuid":"kurokuma'sfactionmod-newfactionsaddon.pack","order":33,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1861528030/Kurokuma'sFactionMod-NewFactionsAddon.pack","name":"【已更新，支持1.7】黑熊的非官方DLC part 3 -- 额外开局势力（无立绘mod者用）","short":"[img]https://steamuserimages-a.akamaihd.net/ugc/1023947384901462665/C83C61421FBF1EE961B051A82BAB3D1F830071DD/[/img]\r\n\r\n[h1]特别注意[/h1]\r\n如果你正在使用武将合集、或是名将复兴、或是MTU，请使用兼容版本的本mod。\r\n\r\n[url=https://steamcommun","category":"campaign","owned":false},{"uuid":"tk3k_vhten.pack","order":60,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1807903100/TK3K_VHTen.pack","name":"NQ: Việt Hóa Chỉ Tên Tướng Và Thành 1.7.0","short":"1.7.0 Đã tương thích theo DLC mới nhất\r\nThay đổi lại một vài tên nhân vật\r\nBug trắng tên fixed\r\n\r\n\r\n\r\n\r\n\r\nĐã tương thích bản 1.6.0\r\n- Với sự trợ giúp của Lân Trịnh Và Nguyễn Lâm\r\n\r\n*Vài thay đổi nhỏ*\r","category":"ui","owned":false},{"uuid":"nhoquyen_viethoa.pack","order":35,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/2443361017/NhoQuyen_VietHoa.pack","name":"NQ: Việt Hóa - Vietnamese Translate Pack - Made by Nhỏ Quyên - ver 5.1.0 (Full 1.7.2)","short":"[h1] Cập nhật 18.06.2023 [/h1]\r\n[b] Các phiên bản cũ hơn từ 1.7.1a trở về trước sẽ có lỗi mất text, thiếu text,.... [/b]\r\n\r\n[h1] Donate - Ủng hộ[/h1]\r\n[b] Vietcombank:[/b] [i]0271001047858[/i] - Nguyễ","category":"graphical","owned":false},{"uuid":"zmore_additional_generals.pack","order":59,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/3423581633/zMore_Additional_Generals.pack","name":"More Additional Generals 1.0 - (Zuo Ci)","short":"Adds 10 new generals to the game!\r\n8 Female Generals, and 2 Male generals.\r\n\r\n4 Children generals who are birthed under family tree.\r\n6 Generals that can be accepted or refused via events.\r\n\r\nThis mod","category":"units","owned":false},{"uuid":"hmd.pack","order":49,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/common/Total War THREE KINGDOMS/data/hmd.pack","name":"hmd.pack","short":"","category":"","owned":true},{"uuid":"hanmacdiem.pack","order":2,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/common/Total War THREE KINGDOMS/data/HanMacDiem.pack","name":"HanMacDiem.pack","short":"","category":"","owned":true},{"uuid":"hmd2.pack","order":50,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/common/Total War THREE KINGDOMS/data/HMD2.pack","name":"HMD2.pack","short":"","category":"","owned":true},{"uuid":"nvjianglaitou_nzj_21-one roung.pack","order":76,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1868374506/nvjianglaitou_NZJ_21-one roung.pack","name":"女将首回来投-ZT立绘版","short":"本mod不涉及ceo修改，放心使用\r\n和武将合集使用，来投时间会被推迟\r\n和名将复兴使用，部分武将会没有护甲，暂时难以解决\r\n需开新档\r\n\r\n\r\n首回来投：\r\n张星彩\r\n步练师\r\n董白\r\n黄月英\r\n王异\r\n关银屏\r\n曹华\r\n张春华\r\n马云禄\r\n吕玲绮\r\n甄姬\r\n大乔\r\n小乔\r\n邹夫人\r\n夏侯姬\r\n郭女王\r\n蔡文姬\r\n王元姬\r\n鲍三娘\r\n辛宪英\r\n\r\n\r\n立绘使用的是ZT的立绘\r\n---------","category":"graphical","owned":false},{"uuid":"nvjianglaitou_nzj_21.pack","order":77,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1843013864/nvjianglaitou_NZJ_21.pack","name":"女将来投-ZT立绘版","short":"女将来投-ZT立绘版\r\n\r\n本mod不涉及ceo修改，放心使用\r\n和武将合集使用，来投时间会被推迟\r\n和名将复兴使用，部分武将会没有护甲，暂时难以解决\r\n需开新档\r\n\r\n鉴于大家反应前期来投女将太多导致无饷可发，改为分批来投\r\n首回来投：\r\n张星彩\r\n步练师\r\n董白\r\n\r\n23回来投：\r\n黄月英\r\n王异\r\n关银屏\r\n曹华\r\n\r\n33回来投：\r\n张春华\r\n马云禄\r\n吕玲绮\r\n甄姬\r\n\r\n43回来投：","category":"graphical","owned":false},{"uuid":"zhurong2.pack","order":42,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/2496249830/zhurong2.pack","name":"祝融夫人/Lady Zhurong","short":"欢迎大家光临小A创意工坊\r\nWelcome to Amaranthen's Creative Works