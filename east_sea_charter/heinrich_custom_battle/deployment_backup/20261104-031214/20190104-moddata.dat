[{"uuid":"3k_0_turn_item.pack","order":26,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1889475347/3k_0_turn_item.pack","name":"0턴 아이템 획득 - 1.7.0","short":"[h2] Player receives Unique x1, Refined x20, Common x20 items at Turn 0.[/h2]\r\n[h2]플레이어는 0턴에 고유 x1, 고급 x20, 중급 x20 아이템을 획득합니다.[/h2]\r\n\r\n-----------------------------------------------------------------","category":"campaign","owned":false},{"uuid":"@changefemalehead.pack","order":28,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1795581907/@changefemalehead.pack","name":"change female's head","short":"My English is not good\r\n\r\nI just change female's head\r\nThe body is still using the original\r\n\r\nI only modify the large_panel in Patch 1.4.0\r\nThe small_panel is still the original\r\n\r\nI add some new fac","category":"graphical","owned":false},{"uuid":"@lf_prime_minister.pack","order":21,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/2013014637/@LF_prime_minister.pack","name":"Unlock prime minister","short":"Function:\r\nHan: unlock \"Prime Minister\"\r\nBandit: unlock \"Right Hand\"\r\nNanman: unlock \"Advisor\"\r\nwhen new campaign start\r\n\r\nNot Compatible with MODs also modified minister system","category":"campaign","owned":false},{"uuid":"@moreuniqueshurb.pack","order":11,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1839123094/@moreuniqueshurb.pack","name":"More Unique Characters (8p assets for 3k characters)","short":"Hello, this is a personal mod I made recently but figured other people might want it. This mod gives 8 princes assets (model, voice, skill tree, etc...) to certain main campaign characters to make the","category":"overhaul","owned":false},{"uuid":"@z_all_characters_custbatt.pack","order":27,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/2027421213/@z_all_characters_custbatt.pack","name":"All Characters for Custom battle 自定义战斗全人物","short":"This mod allows you to use all characters in customer battle, including Xu Shu, Wang Lang, Li Jue, Liu Yao, Ji Ling, Lady Bian and Lady Mi. \r\nShould be compatible with most mods. Some characters’ name","category":"battle","owned":false},{"uuid":"@z_more_unique_units.pack","order":12,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1791625902/@Z_more_unique_units.pack","name":"More Unique Units 更多特殊兵种","short":"Steam's problem deleted my English description and I don't have any backup.\r\nBasically this mod adds 47 unique units to the game. Some units is faction unique units that can be recruit by certain fact","category":"units","owned":false},{"uuid":"@zspecial_units_for_ll.pack","order":48,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1791296989/@Zspecial_units_for_LL.pack","name":"Recruited unique character can use their special units","short":"[h1] Introduction: [/h1]\r\nThis mod allows most unique character can recruit their \"original\" faction's special units. If I play as Liu Bei and Xiahou Yuan in my function can still recruit Tiger and Le","category":"campaign","owned":false},{"uuid":"[mod]8king.pack","order":12,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/2231989631/[MOD]8king.pack","name":"Eight princes(for Three kingdoms)","short":"It was designed to recycle DLC, Eight princes, which is rarely bought.\r\nEight princes, I bring 8 main heroes of DLC to the Three Kingdoms Period.\r\nIt applies to all DLC\r\nSummoned Eight princes with th","category":"campaign","owned":false},{"uuid":"[mod]lady_bian_flc.pack","order":15,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/common/Total War THREE KINGDOMS/data/[mod]Lady_bian_FLC.pack","name":"Make Them Unique 3.3 (Wu Anguo)","short":"[img]https://i.imgur.com/f48A4bb.jpg[/img]\r\n\r\n[img]https://i.imgur.com/0eT2bM5.jpg[/img]\r\n\r\n\r\n*This is graphic oriented mod but at the same time it also overhaul mod. \r\n\r\n\r\n\r\n[url=https://discord.gg/W","category":"graphical","owned":false},{"uuid":"[mod]two_qiaos.pack","order":29,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/2027527569/[mod]Two_Qiaos.pack","name":"Da Qiao & Xiao Qiao MTU modeling exchange mod","short":"[h1]Place this mod above MTU[/h1]\r\n\r\n[img]https://i.imgur.com/Yu5M17D.jpg[/img]\r\n\r\n[img]https://i.imgur.com/2g8hm5X.jpg[/img]\r\n\r\n\r\n\r\n[img]https://i.imgur.com/Cm1N2vc.jpg[/img]\r\n\r\nExchange illustration","category":"graphical","owned":false},{"uuid":"_ai_hell.pack","order":12,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1855117575/_ai_hell.pack","name":"AI HELL","short":"AI HELL\r\n[h1]Main Features[/h1]\r\n[*] Improves strategic difficulty of campaigns.\r\n[*] Increases AI expansion speed and aggression.\r\n[*] AI not only draw a lot of troops, but also act strategically.\r\n[","category":"overhaul","owned":false},{"uuid":"_spawn_ancillary_script_10.pack","order":13,"active":false,"game":"threekingdoms","packfile":"","name":"Give Ancillaries without event","short":"Get ancillaries without event screen at first turn.\r\n\r\nThis means [b]compatible with any mods[/b] especially 1 turn event mods.\r\n\r\n x1 available unique, x10 others, player only\r\n\r\n※ Updated: No compat","category":"campaign","owned":false},{"uuid":"all_court.pack","order":30,"active":false,"game":"threekingdoms","packfile":"D:/SteamLibrary/steamapps/workshop/content/779340/1812584992/all_court.pack","name":"all_court.pack","short":"This mod unlocks all court positions for all ranks. Governors remain untouched.","category":"campaign","owned":false},{"uuid":"armor_sunren.pack","order":28,"active":false,"ga